#: ../../contributing.rst:2
msgid "Contributing"
msgstr "Внесок у проєкт"

#: ../../contributing.rst:4
msgid ""
"We welcome contributions to ByByte! This document provides guidelines for "
"contributing."
msgstr ""
"Ми вітаємо внески до ByByte! Цей документ містить настанови щодо того, як "
"зробити свій внесок."

#: ../../contributing.rst:7
msgid "Getting Started"
msgstr "Початок роботи"

#: ../../contributing.rst:9
msgid "Fork the repository on GitHub"
msgstr "Зробіть форк репозиторію на GitHub"

#: ../../contributing.rst:10
msgid "Clone your fork locally"
msgstr "Клонуйте свій форк локально"

#: ../../contributing.rst:11
msgid "Create a new branch for your feature or bugfix"
msgstr "Створіть нову гілку для вашої функції або виправлення помилки"

#: ../../contributing.rst:12
msgid "Make your changes"
msgstr "Внесіть свої зміни"

#: ../../contributing.rst:13
msgid "Test your changes"
msgstr "Протестуйте свої зміни"

#: ../../contributing.rst:14
msgid "Submit a pull request"
msgstr "Надішліть запит на злиття (pull request)"

